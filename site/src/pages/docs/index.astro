---
import Base from "../../layouts/Base.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const docs = [
  ["Install", "install", "uvx, pipx, and what Agent Guard needs (and never does)."],
  ["Quickstart", "quickstart", "Scan a skill, a repository, a package or your machine; read the verdict."],
  ["How it works", "how-it-works", "Why it exists, the gaps it closes, the pipeline, architecture, code and algorithms."],
  ["CLI reference", "cli", "Every command and option, generated from the CLI."],
  ["Configuration", "config", "The .agentguard.yaml file."],
  ["Policy", "policy", "Presets, requirements, allow and deny lists, and the least-privilege policy."],
  ["Suppressions", "suppressions", "Accepting findings with a reason and an expiry."],
  ["CI integration", "ci", "GitHub Action with pull-request mode, pre-commit, and agent hooks."],
  ["Web scanner", "web-scanner", "Scan pasted text, files and GitHub links in the browser; privacy, limits, deployment."],
  ["Output formats", "output", "JSON, SARIF, Markdown, HTML, JUnit, CycloneDX; agent-safe output."],
  ["Library API", "library-api", "Use the engine from Python, workers or Pyodide."],
  ["MCP spec support", "mcp-spec-support", "Which MCP specification versions and extensions each rule area covers."],
  ["Limitations", "limitations", "What Agent Guard does not do yet, and what comes next."],
];
---
<Base title="Documentation">
  <h1>Documentation</h1>
  <div class="cards">
    {docs.map(([t, slug, d]) => (<section class="card"><h2><a href={`${base}/docs/${slug}/`}>{t}</a></h2><p class="muted">{d}</p></section>))}
  </div>
</Base>
