---
// Sign in: Google and GitHub through Supabase Auth (public/js/account.js). Apple, SSO and email and
// password are laid out but not switched on yet. Built only when the site has a Supabase project.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { auth } from "../../data/auth";
export function getStaticPaths() {
  return auth.enabled ? [{ params: { slug: undefined } }] : [];
}
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Base title="Sign in" description="Sign in to Agent Guard to keep the scan reports you choose to save.">
  <div class="signin">
    <h1>Sign in to Agent Guard</h1>

    <noscript><p class="alert">Signing in needs JavaScript.</p></noscript>
    <div id="signin-error" class="alert" role="alert" hidden></div>
    <div id="signin-done" class="notice signin-done" hidden>
      <p>Signed in as <strong id="signin-who"></strong>.</p>
      <p class="row"><a class="btn small" href={`${base}/account/`}>Go to My scans</a> <button type="button" id="signin-out" class="btn secondary small">Sign out</button></p>
    </div>

    <div class="providers" aria-label="Sign in with">
      <button type="button" class="provider" data-oauth="google" disabled>
        <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" /><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" /><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" /><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" /></svg>
        Google
      </button>
      <button type="button" class="provider" disabled aria-describedby="signin-soon">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" /></svg>
        Apple <span class="soon">Soon</span>
      </button>
      <button type="button" class="provider" data-oauth="github" disabled>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
        GitHub
      </button>
      <button type="button" class="provider wide" disabled aria-describedby="signin-soon">
        <Icon name="lock" class="icon small-icon" /> Continue with SSO <span class="soon">Soon</span>
      </button>
    </div>

    <div class="or" role="separator"><span>or</span></div>

    <form id="signin-form" class="signin-form" novalidate>
      <fieldset disabled aria-describedby="signin-soon">
        <label for="signin-email" class="field-label">Email</label>
        <input id="signin-email" type="email" autocomplete="email" />
        <label for="signin-password" class="field-label">Password</label>
        <div class="password">
          <input id="signin-password" type="password" autocomplete="current-password" />
          <button type="button" class="reveal" aria-label="Show password"><Icon name="eye" class="icon" /></button>
        </div>
      </fieldset>
      <label class="check"><input id="signin-remember" type="checkbox" checked /> Keep me signed in on this device</label>
      <button type="submit" class="btn signin-submit" disabled aria-describedby="signin-soon">Sign in</button>
      <p id="signin-soon" class="muted small signin-soon">Apple, SSO and email sign-in are coming soon. Use Google or GitHub for now.</p>
    </form>

    <p class="signin-links">Don't have an account? Signing in with Google or GitHub creates one.</p>
    <p class="signin-links muted">Forgot your email or password? Recovery arrives with email sign-in.</p>

    <p class="signin-terms">By continuing, you agree to Agent Guard's <a href={`${base}/terms/`}>terms</a> and <a href={`${base}/privacy/`}>privacy policy</a>. Signing in stores your Google or GitHub account's name and email with Supabase; reports are saved only when you choose to save them.</p>
  </div>
  <script is:inline type="module" src={`${base}/js/signin-page.js`}></script>
</Base>
