---
// How many rules each family of the catalogue has (horizontal bars, from the generated rule catalog).
import Figure from "./Figure.astro";
import { FAMILY_SHORT } from "../../data/families";
const { rules, families } = Astro.props;
const rows = families.map((f) => ({ name: FAMILY_SHORT[f.family] ?? f.name, n: rules.filter((r) => r.family === f.family).length }))
  .filter((r) => r.n > 0).sort((a, b) => b.n - a.n);
const counted = rows.reduce((a, r) => a + r.n, 0);
const extensions = rules.filter((r) => r.extension).length;
const max = Math.max(...rows.map((r) => r.n));

function layout(W) {
  const narrow = W < 500, labelW = narrow ? 150 : 190, rowH = 26, bar = 14, right = 34;
  const plotW = W - labelW - right;
  const items = rows.map((r, i) => {
    const y = 6 + i * rowH, w = Math.max(2, plotW * r.n / max), x = labelW, rr = Math.min(4, w);
    const d = `M${x},${y}H${x + w - rr}Q${x + w},${y} ${x + w},${y + rr}V${y + bar - rr}Q${x + w},${y + bar} ${x + w - rr},${y + bar}H${x}Z`;
    return { ...r, y, w, d };
  });
  return { W, H: 10 + rows.length * rowH, labelW, bar, items };
}
const views = [["v-wide", layout(640)], ["v-narrow", layout(360)]];
---
<Figure id="areas" title={`${rules.length} rules by family`}
  note={`${rules.length - extensions} rules make up the catalogue; ${extensions} more extend it (policy outcomes and MCP extensions). Every rule has unsafe and safe fixtures that CI runs on every change. A higher count is not better coverage: one well-made rule can cover a whole technique.`}>
  {views.map(([cls, L]) => (
    <svg class={cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`areas-${cls}-d`}>
      <desc id={`areas-${cls}-d`}>{rows.map((r) => `${r.name}: ${r.n}.`).join(" ")}</desc>
      <line class="c-base" x1={L.labelW} x2={L.labelW} y1="0" y2={L.H - 4} />
      {L.items.map((r) => (
        <g class="mark">
          <title>{r.name}: {r.n} rules</title>
          <text class="c-lbl" x={L.labelW - 10} y={r.y + L.bar / 2 + 4} text-anchor="end">{r.name}</text>
          <path class="s1" d={r.d} />
          <text class="c-val" x={L.labelW + r.w + 6} y={r.y + L.bar / 2 + 4}>{r.n}</text>
        </g>
      ))}
    </svg>
  ))}
  {counted !== rules.length && <p class="chart-note">{rules.length - counted} rules belong to no family above.</p>}
</Figure>
