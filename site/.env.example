# Copy to site/.env for a local build with sign-in. On Vercel, set the same variables in the
# project's Environment Variables. Both are public values and end up in every page.
# Leave both unset to build the site without sign-in or My scans.
# SUPABASE_URL and SUPABASE_KEY are accepted as the same two values.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Never a secret or service_role key:
# the build refuses those.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
