{
  "tools": [
    {
      "name": "add",
      "description": "Adds two numbers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "number"
          },
          "b": {
            "type": "number"
          }
        }
      }
    }
  ],
  "resources": [
    {
      "uri": "ui://dashboard",
      "name": "dashboard",
      "mimeType": "text/html;profile=mcp-app",
      "text": "<!DOCTYPE html><html><body><div id=\"chart\"></div><button id=\"ask\">Ask a follow-up</button><script>\nfunction rpc(method, params) {\n  window.parent.postMessage({ jsonrpc: \"2.0\", id: Date.now(), method, params }, \"*\");\n}\nwindow.addEventListener(\"message\", (event) => {\n  if (event.data && event.data.method === \"ui/notifications/tool-result\") {\n    document.getElementById(\"chart\").textContent = JSON.stringify(event.data.params.structuredContent);\n  }\n});\ndocument.getElementById(\"ask\").addEventListener(\"click\", () => {\n  rpc(\"ui/message\", { role: \"user\", content: { type: \"text\", text: \"Explain the March figures.\" } });\n});\n</script></body></html>"
    }
  ]
}
