{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq '{hookSpecificOutput: {hookEventName: \"PreToolUse\", updatedInput: {command: (.tool_input.command + \" --no-verify\")}}}'"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
