{
  "$defs": {
    "AivssDefaults": {
      "additionalProperties": false,
      "properties": {
        "threat": {
          "default": "poc",
          "enum": [
            "attacked",
            "poc",
            "unreported"
          ],
          "title": "Threat",
          "type": "string"
        },
        "cvss_base": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cvss Base"
        }
      },
      "title": "AivssDefaults",
      "type": "object"
    },
    "AnalyzerMatch": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "analyzer",
          "default": "analyzer",
          "title": "Type",
          "type": "string"
        },
        "analyzer": {
          "title": "Analyzer",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "analyzer"
      ],
      "title": "AnalyzerMatch",
      "type": "object"
    },
    "Category": {
      "description": "What a finding is about. The three are never mixed into one list.",
      "enum": [
        "malice",
        "vulnerability",
        "hygiene"
      ],
      "title": "Category",
      "type": "string"
    },
    "Confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Downgrade": {
      "additionalProperties": false,
      "description": "Report a regex match at a lower severity (and one level lower\nconfidence) when it is a *mention* rather than a directive. Every\ncondition given must hold; the first matching downgrade wins. Hidden or\ndecoded matches are still escalated one level afterwards.\n\nA downgraded match never counts on its own: a ``block``-lane rule reports\nit in the ``evidence`` lane (the finding carries the ``mention`` tag).",
      "properties": {
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "in_code": {
          "default": false,
          "title": "In Code",
          "type": "boolean"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "quoted": {
          "default": false,
          "title": "Quoted",
          "type": "boolean"
        },
        "patterns": {
          "items": {
            "type": "string"
          },
          "title": "Patterns",
          "type": "array"
        },
        "window": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        },
        "declared": {
          "items": {
            "type": "string"
          },
          "title": "Declared",
          "type": "array"
        }
      },
      "required": [
        "severity"
      ],
      "title": "Downgrade",
      "type": "object"
    },
    "FixKind": {
      "enum": [
        "auto",
        "patch",
        "guidance",
        "remove",
        "none"
      ],
      "title": "FixKind",
      "type": "string"
    },
    "Lane": {
      "description": "How much a rule may decide alone (spec/rules.md, \"Lanes\").",
      "enum": [
        "block",
        "evidence",
        "hunt"
      ],
      "title": "Lane",
      "type": "string"
    },
    "Mapping": {
      "properties": {
        "framework": {
          "title": "Framework",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "todo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Todo"
        }
      },
      "required": [
        "framework"
      ],
      "title": "Mapping",
      "type": "object"
    },
    "RegexMatch": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "regex",
          "default": "regex",
          "title": "Type",
          "type": "string"
        },
        "patterns": {
          "items": {
            "type": "string"
          },
          "title": "Patterns",
          "type": "array"
        },
        "scopes": {
          "items": {
            "enum": [
              "body",
              "frontmatter",
              "hidden",
              "decoded",
              "code",
              "resolved",
              "tool_text",
              "server_instructions",
              "command",
              "media_text",
              "config_value",
              "prose_fold"
            ],
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "require": {
          "items": {
            "type": "string"
          },
          "title": "Require",
          "type": "array"
        },
        "unless": {
          "items": {
            "type": "string"
          },
          "title": "Unless",
          "type": "array"
        },
        "window": {
          "default": 3,
          "title": "Window",
          "type": "integer"
        },
        "ignore_case": {
          "default": true,
          "title": "Ignore Case",
          "type": "boolean"
        },
        "sections": {
          "items": {
            "type": "string"
          },
          "title": "Sections",
          "type": "array"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "not_paths": {
          "items": {
            "type": "string"
          },
          "title": "Not Paths",
          "type": "array"
        },
        "lower_confidence_in_code": {
          "default": false,
          "title": "Lower Confidence In Code",
          "type": "boolean"
        },
        "comments": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comments"
        },
        "downgrade": {
          "items": {
            "$ref": "#/$defs/Downgrade"
          },
          "title": "Downgrade",
          "type": "array"
        },
        "max_matches": {
          "default": 5,
          "title": "Max Matches",
          "type": "integer"
        }
      },
      "required": [
        "patterns"
      ],
      "title": "RegexMatch",
      "type": "object"
    },
    "RuleStatus": {
      "enum": [
        "planned",
        "experimental",
        "stable",
        "deprecated"
      ],
      "title": "RuleStatus",
      "type": "string"
    },
    "RuleVariant": {
      "additionalProperties": false,
      "description": "A narrower detector under a catalogue rule. Unset fields come from the head.",
      "properties": {
        "key": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "why": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why"
        },
        "severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Severity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lane": {
          "anyOf": [
            {
              "$ref": "#/$defs/Lane"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Category"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "applies_to": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies To"
        },
        "match": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "analyzer": "#/$defs/AnalyzerMatch",
                  "regex": "#/$defs/RegexMatch",
                  "yara": "#/$defs/YaraMatch"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/RegexMatch"
                },
                {
                  "$ref": "#/$defs/AnalyzerMatch"
                },
                {
                  "$ref": "#/$defs/YaraMatch"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match"
        },
        "remediation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation"
        },
        "fix": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fix_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fix Action"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "cvss4_vector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cvss4 Vector"
        },
        "aivss": {
          "anyOf": [
            {
              "$ref": "#/$defs/AivssDefaults"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "network": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "key"
      ],
      "title": "RuleVariant",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "YaraMatch": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "yara",
          "default": "yara",
          "title": "Type",
          "type": "string"
        },
        "rule_file": {
          "title": "Rule File",
          "type": "string"
        }
      },
      "required": [
        "rule_file"
      ],
      "title": "YaraMatch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A catalogue rule: the head merged with its detection entry.",
  "properties": {
    "id": {
      "pattern": "^AG-[A-Z]{2,7}-\\d{3}$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "family": {
      "default": "",
      "title": "Family",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/Category",
      "default": "malice"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence",
      "default": "medium"
    },
    "lane": {
      "$ref": "#/$defs/Lane",
      "default": "evidence"
    },
    "engine": {
      "default": "instruction",
      "title": "Engine",
      "type": "string"
    },
    "applies_to": {
      "items": {
        "type": "string"
      },
      "title": "Applies To",
      "type": "array"
    },
    "match": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "analyzer": "#/$defs/AnalyzerMatch",
              "regex": "#/$defs/RegexMatch",
              "yara": "#/$defs/YaraMatch"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RegexMatch"
            },
            {
              "$ref": "#/$defs/AnalyzerMatch"
            },
            {
              "$ref": "#/$defs/YaraMatch"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Match"
    },
    "mappings": {
      "items": {
        "$ref": "#/$defs/Mapping"
      },
      "title": "Mappings",
      "type": "array"
    },
    "remediation": {
      "default": "",
      "title": "Remediation",
      "type": "string"
    },
    "fix": {
      "$ref": "#/$defs/FixKind",
      "default": "guidance"
    },
    "fix_action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fix Action"
    },
    "why": {
      "default": "",
      "title": "Why",
      "type": "string"
    },
    "references": {
      "items": {
        "type": "string"
      },
      "title": "References",
      "type": "array"
    },
    "cvss4_vector": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cvss4 Vector"
    },
    "aivss": {
      "$ref": "#/$defs/AivssDefaults"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "network": {
      "default": false,
      "title": "Network",
      "type": "boolean"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/RuleStatus",
      "default": "planned"
    },
    "aliases": {
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "blocks_allow": {
      "default": false,
      "title": "Blocks Allow",
      "type": "boolean"
    },
    "severity_from_content": {
      "default": false,
      "title": "Severity From Content",
      "type": "boolean"
    },
    "extension": {
      "default": false,
      "title": "Extension",
      "type": "boolean"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/RuleVariant"
      },
      "title": "Variants",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title",
    "severity"
  ],
  "title": "RuleDef",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.dev/schemas/rule.v1.json"
