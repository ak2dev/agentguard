{
  "$defs": {
    "LockEntry": {
      "description": "One approved artifact in ``agentguard.lock`` (spec/interfaces.md §6).",
      "properties": {
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "default": "",
          "title": "Type",
          "type": "string"
        },
        "ecosystem": {
          "default": "",
          "title": "Ecosystem",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "root": {
          "default": "",
          "title": "Root",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "tree_sha256": {
          "default": "",
          "title": "Tree Sha256",
          "type": "string"
        },
        "files": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Files"
        },
        "external_refs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "External Refs",
          "type": "object"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "risk_tier": {
          "default": "",
          "title": "Risk Tier",
          "type": "string"
        },
        "verdict": {
          "default": "",
          "title": "Verdict",
          "type": "string"
        },
        "accepted_findings": {
          "items": {
            "type": "string"
          },
          "title": "Accepted Findings",
          "type": "array"
        },
        "approved_by": {
          "default": "",
          "title": "Approved By",
          "type": "string"
        },
        "approved_at": {
          "default": "",
          "title": "Approved At",
          "type": "string"
        },
        "review_by": {
          "default": "",
          "title": "Review By",
          "type": "string"
        },
        "launch": {
          "anyOf": [
            {
              "$ref": "#/$defs/LockLaunch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tools": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        },
        "tool_definitions": {
          "anyOf": [
            {
              "additionalProperties": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Definitions"
        },
        "server_instructions_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server Instructions Sha256"
        }
      },
      "title": "LockEntry",
      "type": "object"
    },
    "LockLaunch": {
      "description": "How an MCP server is started or reached. ``sha256`` covers all of it, so a\nchanged command, argument or URL under the same name is caught (AG-MCP-012).",
      "properties": {
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "sha256": {
          "default": "",
          "title": "Sha256",
          "type": "string"
        }
      },
      "title": "LockLaunch",
      "type": "object"
    }
  },
  "properties": {
    "lock_version": {
      "default": 2,
      "enum": [
        1,
        2
      ],
      "title": "Lock Version",
      "type": "integer"
    },
    "tool_hash_version": {
      "default": 1,
      "description": "What a tool hash covers. 1 (also locks without this field): name, title, description, input_schema and annotations. 2: also output_schema, when the tool has one.",
      "enum": [
        1,
        2
      ],
      "title": "Tool Hash Version",
      "type": "integer"
    },
    "generated_by": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Generated By",
      "type": "object"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/LockEntry"
      },
      "title": "Artifacts",
      "type": "array"
    }
  },
  "title": "Lockfile",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.dev/schemas/lock.v1.json"
}
