        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        },
        "narrative": {
          "default": "",
          "title": "Narrative",
          "type": "string"
        },
        "sink": {
          "default": "",
          "title": "Sink",
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "steps"
      ],
      "title": "Chain",
      "type": "object"
    },
    "Component": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
