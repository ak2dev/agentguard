      "description": "How much a rule may decide alone (spec/rules.md, \"Lanes\").",
      "enum": [
        "block",
        "evidence",
        "hunt"
      ],
      "title": "Lane",
      "type": "string"
    },
    "LeastPrivilege": {
      "description": "The smallest grant that covers what a component was observed to do (engine J, PLAN §6 \"policy output\").\n\n``allowed_tools`` is the value for a skill's ``allowed-tools``; ``permissions`` and ``sandbox`` are in the\nshape of an agent's settings file. It is a proposal for the reviewer, never applied by a scan.",
      "properties": {
        "allowed_tools": {
          "items": {
