      "type": "object"
    },
    "ComponentKind": {
      "enum": [
        "agent_host",
        "skill",
        "instruction_file",
        "subagent",
        "command",
        "mcp_server",
        "mcp_client_config",
        "package",
        "plugin",
        "marketplace",
        "settings",
        "hook",
        "ci_workflow",
        "workspace",
        "container",
        "connector",
        "bundle",
        "repository"
