        },
        "level": {
          "default": "",
          "title": "Level",
          "type": "string"
        },
        "seconds": {
          "default": 0.0,
          "title": "Seconds",
          "type": "number"
        },
        "not_reached": {
          "items": {
            "type": "string"
          },
          "title": "Not Reached",
          "type": "array"
        }
      },
      "title": "DynamicLimits",
      "type": "object"
    },
