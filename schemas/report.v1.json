{
  "$defs": {
    "Adjudication": {
      "description": "What the model adjudicator said about a finding. It may raise and add;\nit may lower by one level at most, and never a deterministic block-lane rule.",
      "properties": {
        "status": {
          "default": "not_run",
          "enum": [
            "confirmed",
            "doubted",
            "dismissed",
            "added",
            "not_run"
          ],
          "title": "Status",
          "type": "string"
        },
        "runs": {
          "default": 0,
          "title": "Runs",
          "type": "integer"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        }
      },
      "title": "Adjudication",
      "type": "object"
    },
    "AnalyzerRun": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "ran",
            "skipped",
            "errored"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "title": "AnalyzerRun",
      "type": "object"
    },
    "Artifact": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ArtifactRole"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "component_id",
        "path",
        "role",
        "sha256",
        "size"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactRole": {
      "enum": [
        "skill_md",
        "instruction_md",
        "script",
        "reference",
        "asset",
        "client_config",
        "server_json",
        "tool_manifest",
        "source_code",
        "package_manifest",
        "lockfile",
        "ui_resource",
        "binary",
        "archive",
        "other",
        "settings",
        "hook_config",
        "plugin_manifest",
        "marketplace_manifest",
        "bundle_manifest",
        "command_md",
        "workflow",
        "workspace_config",
        "dockerfile",
        "compose",
        "descriptor",
        "env_file",
        "image",
        "document",
        "notebook",
        "html",
        "media",
        "repo_code",
        "repo_doc"
      ],
      "title": "ArtifactRole",
      "type": "string"
    },
    "ArtifactSummary": {
      "description": "One scanned component, as the report lists it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "ecosystem": {
          "default": "",
          "title": "Ecosystem",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "root": {
          "default": "",
          "title": "Root",
          "type": "string"
        },
        "component_id": {
          "default": "",
          "title": "Component Id",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "risk_tier": {
          "$ref": "#/$defs/RiskTier",
          "default": "L0"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict",
          "default": "ALLOW"
        },
        "findings": {
          "default": 0,
          "title": "Findings",
          "type": "integer"
        },
        "least_privilege": {
          "anyOf": [
            {
              "$ref": "#/$defs/LeastPrivilege"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "triage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Triage"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "ArtifactSummary",
      "type": "object"
    },
    "CapLabel": {
      "enum": [
        "reads_private_data",
        "ingests_untrusted_content",
        "external_egress",
        "destructive",
        "code_exec",
        "credential_access",
        "persistence",
        "auto_approved",
        "fs_read",
        "fs_write_workspace",
        "fs_write_outside",
        "shell",
        "financial",
        "host_elevated"
      ],
      "title": "CapLabel",
      "type": "string"
    },
    "Capability": {
      "properties": {
        "label": {
          "$ref": "#/$defs/CapLabel"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "declared": {
          "default": false,
          "title": "Declared",
          "type": "boolean"
        },
        "observed": {
          "default": false,
          "title": "Observed",
          "type": "boolean"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "medium"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "label",
        "subject"
      ],
      "title": "Capability",
      "type": "object"
    },
    "Category": {
      "description": "What a finding is about. The three are never mixed into one list.",
